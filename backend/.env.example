# Database conn for localized development
# yourpassword will be the password you set for your local Postgres database
# db_name will be the name of your local Postgres database
# you can just use scuffed_trello for db_name if you want, but make sure to create the database in Postgres first

DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/db_name

# Secret used to sign session cookies — change this to a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string

# Secret backing the AES-256-GCM envelope around each user's stored Anthropic API
# key (BYOK AI assistant). Set a long random string in production. Rotating it
# makes already-stored keys undecryptable, so users must re-enter their key.
# Falls back to SESSION_SECRET if unset.
AI_KEY_SECRET=change-me-to-another-long-random-string

# Frontend origin (for CORS + OAuth redirects) and this server's own URL (for OAuth callbacks)
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:4000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# DigitalOcean Spaces (S3-compatible object storage) for image uploads.
# Create an access key at: DO panel → API → Spaces Keys
# SPACES_REGION:   the region slug only, e.g. nyc3 (origin + CDN endpoints are derived from it)
# SPACES_BUCKET:   your Space (bucket) name
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=
SPACES_BUCKET=